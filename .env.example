# ========================================================
# HelloAgent 框架环境变量配置模板 (.env.example)
# 使用说明：
# 1. 复制本文件并重命名为 .env
# 2. 填入你自己的服务商 API Key 和配置
# 3. 切勿将真实的 .env 提交到公开 Git 仓库中
# ========================================================

# --------------------------------------------------------
# 1. 大语言模型 (LLM) 配置 [核心必填]
# --------------------------------------------------------
# 选项 A: DeepSeek (推荐，性价比极高)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_ID=deepseek-chat

# 选项 B: 原生 OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL_ID=gpt-4o-mini

# 选项 C: 阿里通义千问 (DashScope)
# DASHSCOPE_API_KEY=your_dashscope_api_key_here
# LLM_MODEL_ID=qwen-plus

# 选项 D: 本地模型服务 (Ollama / vLLM / One-API)
# LLM_API_KEY=vllm_or_dummy_key
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL_ID=qwen2.5:7b

# --------------------------------------------------------
# 2. 外部搜索引擎工具配置 [选填，使用 SearchTool 时需要]
# --------------------------------------------------------
# Tavily AI 搜索 (获取地址: https://tavily.com/)
TAVILY_API_KEY=your_tavily_api_key_here

# SerpAPI 传统 Google 搜索 (获取地址: https://serpapi.com/)
# SERPAPI_API_KEY=your_serpapi_api_key_here

# --------------------------------------------------------
# 3. 高德地图与 MCP 服务配置 [选填，使用 Amap MCP 时需要]
# --------------------------------------------------------
# 高德 Web服务 API Key (获取地址: https://console.amap.com/)
AMAP_API_KEY=your_amap_api_key_here
# 高德 Web端安全密钥 (可选，用于安全代理)
# AMAP_SECURITY_KEY=your_amap_security_key_here

# --------------------------------------------------------
# 4. 向量数据库与长期记忆 [选填，使用 Qdrant / RAG 时需要]
# --------------------------------------------------------
# Qdrant 云服务或本地 Docker 服务 (http://localhost:6333)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# 文本向量嵌入模型配置 (默认支持阿里 DashScope 与本地 sentence-transformers)
# EMBED_API_KEY=your_dashscope_api_key_here
# EMBED_MODEL_NAME=text-embedding-v4
